# Sanctuary of Mind — Environment Configuration Template
# All keys are strictly optional. The core application runs without paid APIs or external accounts.
# Copy to .env for local overrides. Never commit .env or secrets to version control.

# Optional Supabase persistence (Leave empty for default local/demo persistence adapter)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional Developer / AI Knowledge Tools (Local tests do not require these)
# DEVELOPERKNOWLEDGE_API_KEY=
# TAVILY_API_KEY=
