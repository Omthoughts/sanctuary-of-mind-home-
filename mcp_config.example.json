{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sanctuary of Mind MCP Configuration Example",
  "description": "Copy to ~/.gemini/config/mcp_config.json or workspace MCP directory",
  "mcpServers": {
    "playwright": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ]
    },
    "context7": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  }
}
